{%- elif trailing_pe and trailing_pe != 'N/A' %}
  <div class="kpi"><span class="kpi-label">Trailing P/E</span><span class="kpi-value">{{ trailing_pe }}x</span></div>
{%- endif %}
{%- if targets and targets.mean %}
  <div class="kpi"><span class="kpi-label">Target (mean)</span><span class="kpi-value">${{ targets.mean }}</span>
{%- if targets.upside_pct_mean is not none %}<span class="kpi-delta {{ targets.upside_direction }}">{{ targets.upside_arrow }} {{ targets.upside_pct_mean }}%</span>{% endif %}</div>
{%- endif %}
{%- if next_earnings %}
  <div class="kpi"><span class="kpi-label">Next earnings</span><span class="kpi-value">{{ next_earnings }}</span></div>
{%- endif %}
</div>

